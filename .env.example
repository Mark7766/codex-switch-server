# Database
DATABASE_URL=sqlite+aiosqlite:///app/data/app.db

# Admin
ADMIN_TOKEN=change-me-to-a-random-string

# GitHub (optional, improves API rate limit)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Tencent Cloud COS (for production download acceleration, ~70x speedup vs Singapore direct)
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# Telemetry
TELEMETRY_MAX_EVENTS_PER_MINUTE=60
TELEMETRY_RETENTION_DAYS=90

# ICP/PSB filing (China mainland, required for production)
ICP_FILING_NUMBER=
PSB_FILING_NUMBER=

# ai-working-ok release cache TTL in seconds (default: 300 = 5 minutes)
AI_WORKING_OK_CACHE_TTL=300

